# ---------------------------------------------------------------------------
# Bergeerd website — environment variables
# Copy this file to ".env" and adjust as needed. Vite only exposes vars
# prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------

# Base URL of the bergeerd_api public API (no trailing slash).
# - Local development (API running on port 8080):
#     VITE_API_URL=http://localhost:8080/api
# - Production (API proxied under the same domain via Nginx):
#     VITE_API_URL=https://bergeerd.ir/api
#
# If left empty the website falls back to the static menu in src/data/menuData.ts.
VITE_API_URL=http://localhost:8080/api
