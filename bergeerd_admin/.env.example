# API base URL — the Go backend.
# Local development: the backend runs on http://localhost:8080
# Production:        the backend is proxied by nginx at https://bergeerd.ir/api
VITE_API_URL=http://localhost:8080/api

# Public website, for the "view on site" links. Leave empty in production
# (the panel is served from the same domain, at /admin/).
VITE_SITE_URL=http://localhost:3000
